PORT
NODE_ENV

# No local MongoDB on this machine: use a MongoDB Atlas connection string.
MONGODB_URI

JWT_SECRET
JWT_EXPIRES_IN=1d

# Comma-separated origins allowed by CORS (the v2 Next app).
CORS_ORIGINS

# First admin, created by `npm run seed`.
ADMIN_NAME
ADMIN_EMAIL
ADMIN_PASSWORD

# Booking emails (the meeting form behind "اطلب موقعك الآن"). Without SMTP_HOST, development only logs the emails.
SMTP_HOST
SMTP_PORT=587
SMTP_USER
SMTP_PASS
MAIL_FROM
# Receives every booking request; defaults to the email saved in dashboard settings.
BOOKING_NOTIFY_EMAIL
